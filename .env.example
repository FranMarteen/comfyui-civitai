# Create at https://civitai.com/user/account -> API Keys
CIVITAI_TOKEN=
# Optional, for gated Hugging Face repos: https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional, only if you use Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Where ComfyUI lives (script writes into $COMFY_DIR/models/...)
COMFY_DIR=./ComfyUI
